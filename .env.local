# Environment variables redacted for security.
# Replace the placeholders below with your own values locally or in your deployment platform.
# Do NOT commit secrets to the repo.
NEXT_PUBLIC_SHEET_ENDPOINT=YOUR_SHEET_ENDPOINT_OR_EMPTY
NEXT_PUBLIC_SUPABASE=1
NEXT_PUBLIC_SUPABASE_URL=YOUR_SUPABASE_URL
# Server-side service role key (keep secret, DO NOT set as NEXT_PUBLIC in production)
SUPABASE_KEY=REDACTED_SERVICE_ROLE_KEY
# Client anon key for realtime (safe to expose as NEXT_PUBLIC)
NEXT_PUBLIC_SUPABASE_ANON=REDACTED_ANON_KEY
